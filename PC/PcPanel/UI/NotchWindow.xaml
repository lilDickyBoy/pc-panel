<Window x:Class="PcPanel.UI.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Panel Notch"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Focusable="False" Width="660" Height="270" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource UiFont}" AllowDrop="True">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF"/>
        <LinearGradientBrush x:Key="NoArtBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5E5CE6" Offset="0"/>
            <GradientStop Color="#0A84FF" Offset="1"/>
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="Grooves" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#00000000" Offset="0.30"/>
            <GradientStop Color="#33000000" Offset="0.36"/>
            <GradientStop Color="#00000000" Offset="0.44"/>
            <GradientStop Color="#2A000000" Offset="0.58"/>
            <GradientStop Color="#00000000" Offset="0.66"/>
            <GradientStop Color="#2A000000" Offset="0.80"/>
            <GradientStop Color="#00000000" Offset="0.88"/>
            <GradientStop Color="#66000000" Offset="1.0"/>
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="Sheen" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#55FFFFFF" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="0.45"/>
            <GradientStop Color="#00FFFFFF" Offset="0.6"/>
            <GradientStop Color="#22FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="Bar" TargetType="Rectangle">
            <Setter Property="Width" Value="3"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="RadiusX" Value="1.5"/>
            <Setter Property="RadiusY" Value="1.5"/>
            <Setter Property="Margin" Value="1.5,0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <LinearGradientBrush x:Key="DropGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0A84FF" Offset="0"/>
            <GradientStop Color="#5E5CE6" Offset="0.6"/>
            <GradientStop Color="#BF5AF2" Offset="1"/>
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="DropGlow">
            <GradientStop Color="#660A84FF" Offset="0"/>
            <GradientStop Color="#220A84FF" Offset="0.55"/>
            <GradientStop Color="#000A84FF" Offset="1"/>
        </RadialGradientBrush>
        <Style x:Key="CtrlGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid x:Name="Island" HorizontalAlignment="Center" VerticalAlignment="Top" Width="140" Height="0" Opacity="0">
            <!-- concave "ears" that blend the notch into the top edge (notch style only) -->
            <Path x:Name="EarL" Fill="Black" Data="M0,0 L12,0 L12,12 A12,12 0 0 0 0,0 Z" Width="12" Height="12"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-12,0,0,0"/>
            <Path x:Name="EarR" Fill="Black" Data="M0,0 L12,0 L12,12 A12,12 0 0 0 0,0 Z" Width="12" Height="12"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,-12,0" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform><ScaleTransform ScaleX="-1"/></Path.RenderTransform>
            </Path>

            <!-- notch: the top part is pushed off-screen so only the bottom corners are round.
                 island: the whole pill is visible. -->
            <Rectangle x:Name="IslandShape" Fill="Black" Margin="0,-40,0,0" RadiusX="19" RadiusY="19"/>

            <Grid ClipToBounds="True">
                <!-- ============ IDLE (always-on) ============ -->
                <Grid x:Name="IdlePanel" Opacity="0" IsHitTestVisible="False" Height="32" VerticalAlignment="Top" Margin="16,0,16,0">
                    <TextBlock x:Name="IdleTime" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <StackPanel x:Name="IdleBatteryHost" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="IdleBatteryText" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    </StackPanel>
                </Grid>

                <!-- ============ COMPACT MUSIC ============ -->
                <Grid x:Name="CompactPanel" Opacity="0" IsHitTestVisible="False" Margin="9,0,13,0" Height="38" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="26" Height="26" VerticalAlignment="Center">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><RotateTransform x:Name="RotC"/></Grid.RenderTransform>
                            <Ellipse x:Name="ArtC" Fill="{StaticResource NoArtBrush}"/>
                            <TextBlock x:Name="NoArtC" Style="{StaticResource CtrlGlyph}" FontSize="11" Opacity="0.9"/>
                            <Ellipse x:Name="GroovesC" Fill="{StaticResource Grooves}"/>
                        </Grid>
                        <Ellipse Fill="{StaticResource Sheen}" Opacity="0.5"/>
                        <Ellipse Width="6" Height="6" Fill="Black" Stroke="#66FFFFFF" StrokeThickness="0.6"/>
                    </Grid>
                    <Canvas x:Name="TitleHostC" Grid.Column="1" Width="222" Height="18" ClipToBounds="True" Margin="10,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock x:Name="TitleC" Foreground="White" FontSize="13" FontWeight="SemiBold">
                            <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                        </TextBlock>
                    </Canvas>
                    <StackPanel x:Name="BarsC" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Style="{StaticResource Bar}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.2"/></Rectangle.RenderTransform></Rectangle>
                        <Rectangle Style="{StaticResource Bar}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.2"/></Rectangle.RenderTransform></Rectangle>
                        <Rectangle Style="{StaticResource Bar}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.2"/></Rectangle.RenderTransform></Rectangle>
                        <Rectangle Style="{StaticResource Bar}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.2"/></Rectangle.RenderTransform></Rectangle>
                    </StackPanel>
                </Grid>

                <!-- ============ EXPANDED MUSIC (on hover) ============ -->
                <Grid x:Name="ExpandedPanel" Opacity="0" IsHitTestVisible="False" Margin="18,16,18,14" Width="434" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="76"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="38"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="76" Height="76">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><RotateTransform x:Name="RotE"/></Grid.RenderTransform>
                            <Ellipse x:Name="ArtE" Fill="{StaticResource NoArtBrush}"/>
                            <TextBlock x:Name="NoArtE" Style="{StaticResource CtrlGlyph}" FontSize="28" Opacity="0.9"/>
                            <Ellipse x:Name="GroovesE" Fill="{StaticResource Grooves}"/>
                        </Grid>
                        <Ellipse Fill="{StaticResource Sheen}" Opacity="0.45"/>
                        <Ellipse Width="14" Height="14" Fill="Black" Stroke="#66FFFFFF" StrokeThickness="1"/>
                        <Ellipse Width="4" Height="4" Fill="#333"/>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,10,0">
                        <Canvas x:Name="TitleHostE" Width="292" Height="22" ClipToBounds="True" HorizontalAlignment="Left">
                            <TextBlock x:Name="TitleE" Foreground="White" FontSize="16.5" FontWeight="SemiBold">
                                <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                            </TextBlock>
                        </Canvas>
                        <TextBlock x:Name="ArtistE" Foreground="#A1A1A6" FontSize="13.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="292" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="AppE" Foreground="{StaticResource AccentBrush}" FontSize="11.5" FontWeight="SemiBold" Margin="0,5,0,0" Opacity="0.9"/>
                    </StackPanel>

                    <StackPanel x:Name="BarsE" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0">
                        <Rectangle Style="{StaticResource Bar}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.2"/></Rectangle.RenderTransform></Rectangle>
                        <Rectangle Style="{StaticResource Bar}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.2"/></Rectangle.RenderTransform></Rectangle>
                        <Rectangle Style="{StaticResource Bar}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.2"/></Rectangle.RenderTransform></Rectangle>
                        <Rectangle Style="{StaticResource Bar}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.2"/></Rectangle.RenderTransform></Rectangle>
                    </StackPanel>

                    <Grid Grid.Row="2" Grid.ColumnSpan="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PosText" Foreground="#8E8E93" FontSize="11" VerticalAlignment="Center" Text="0:00"/>
                        <Grid x:Name="Track" Grid.Column="1" Height="16" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Track_Click">
                            <Border Height="5" CornerRadius="2.5" Background="#3A3A3C" VerticalAlignment="Center"/>
                            <Border x:Name="TrackFill" Height="5" CornerRadius="2.5" Background="White" VerticalAlignment="Center" HorizontalAlignment="Left" Width="0"/>
                        </Grid>
                        <TextBlock x:Name="DurText" Grid.Column="2" Foreground="#8E8E93" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0:00"/>
                    </Grid>

                    <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border x:Name="BtnPrev" Width="54" Height="38" Background="Transparent" Cursor="Hand" CornerRadius="19" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                            <TextBlock x:Name="GPrev" Style="{StaticResource CtrlGlyph}" FontSize="20"/>
                        </Border>
                        <Border x:Name="BtnPlay" Width="64" Height="38" Background="Transparent" Cursor="Hand" CornerRadius="19" Margin="14,0" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                            <TextBlock x:Name="GPlay" Style="{StaticResource CtrlGlyph}" FontSize="26"/>
                        </Border>
                        <Border x:Name="BtnNext" Width="54" Height="38" Background="Transparent" Cursor="Hand" CornerRadius="19" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                            <TextBlock x:Name="GNext" Style="{StaticResource CtrlGlyph}" FontSize="20"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ============ INFO (connection, charging, clipboard, file …) ============ -->
                <StackPanel x:Name="InfoPanel" Opacity="0" IsHitTestVisible="False" Orientation="Horizontal" Height="38" VerticalAlignment="Top" HorizontalAlignment="Center">
                    <Grid x:Name="InfoIconHost" Width="28" Height="20" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="InfoGlyph" Style="{StaticResource CtrlGlyph}" FontSize="15" Foreground="{StaticResource AccentBrush}"/>
                    </Grid>
                    <TextBlock x:Name="InfoText" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- ============ VOLUME ============ -->
                <Grid x:Name="VolumePanel" Opacity="0" IsHitTestVisible="False" Height="38" VerticalAlignment="Top" Margin="16,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="VolGlyph" Style="{StaticResource CtrlGlyph}" FontSize="15" HorizontalAlignment="Left"/>
                    <Grid x:Name="VolTrack" Grid.Column="1" Height="6" VerticalAlignment="Center" Margin="4,0,8,0">
                        <Border CornerRadius="3" Background="#3A3A3C"/>
                        <Border x:Name="VolFill" CornerRadius="3" Background="White" HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                    <TextBlock x:Name="VolText" Grid.Column="2" Foreground="White" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>

                <!-- ============ PHONE NOTIFICATION ============ -->
                <Grid x:Name="NotifPanel" Opacity="0" IsHitTestVisible="False" Height="72" VerticalAlignment="Top" Margin="16,0,18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="11" Background="#2C2C2E" VerticalAlignment="Center" ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="NotifGlyph" Style="{StaticResource CtrlGlyph}" FontSize="18"/>
                            <Image x:Name="NotifIcon" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Grid>
                            <TextBlock x:Name="NotifTitle" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,70,0"/>
                            <TextBlock x:Name="NotifApp" Foreground="#8E8E93" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="80" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <TextBlock x:Name="NotifText" Foreground="#D1D1D6" FontSize="12.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ============ INCOMING CALL ============ -->
                <Grid x:Name="CallPanel" Opacity="0" IsHitTestVisible="False" Height="64" VerticalAlignment="Top" Margin="14,0,18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="42" Height="42" VerticalAlignment="Center">
                        <Ellipse x:Name="CallPulse" Fill="#3330D158" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="34" Height="34" Fill="#30D158"/>
                        <Image x:Name="CallIcon" Width="34" Height="34" Stretch="UniformToFill">
                            <Image.Clip><EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17"/></Image.Clip>
                        </Image>
                        <TextBlock x:Name="CallGlyph" Style="{StaticResource CtrlGlyph}" FontSize="16"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0">
                        <TextBlock x:Name="CallName" Foreground="White" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="CallSub" Foreground="#8E8E93" FontSize="12" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- ============ COUNTDOWN ============ -->
                <Grid x:Name="CountdownPanel" Opacity="0" IsHitTestVisible="False" Height="38" VerticalAlignment="Top" Margin="14,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CdGlyph" Style="{StaticResource CtrlGlyph}" FontSize="15" Foreground="#FF9F0A"/>
                    <TextBlock x:Name="CdLabel" Grid.Column="1" Foreground="#FF9F0A" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,12,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="CdTime" Grid.Column="2" Foreground="#FF9F0A" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                </Grid>
                <!-- ============ DRAG & DROP: peek (a drag started somewhere) ============ -->
                <StackPanel x:Name="DropPeekPanel" Opacity="0" IsHitTestVisible="False" Orientation="Horizontal" Height="44" VerticalAlignment="Top" HorizontalAlignment="Center">
                    <Grid Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Ellipse x:Name="PeekDisc" Fill="#2E0A84FF"/>
                        <TextBlock x:Name="PeekGlyph" Style="{StaticResource CtrlGlyph}" FontSize="13" Foreground="#0A84FF">
                            <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                    <TextBlock x:Name="PeekText" Foreground="White" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- ============ DRAG & DROP: hovering over the notch ============ -->
                <Grid x:Name="DropHoverPanel" Opacity="0" IsHitTestVisible="False" Height="178" VerticalAlignment="Top">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Grid Width="92" Height="92" HorizontalAlignment="Center">
                            <Ellipse x:Name="HoverGlow" Fill="{StaticResource DropGlow}" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Rectangle x:Name="HoverDash" Width="64" Height="64" RadiusX="19" RadiusY="19" StrokeThickness="2"
                                       StrokeDashArray="3.2 2.4" StrokeDashCap="Round" Stroke="{StaticResource DropGradient}" Fill="#1A0A84FF"/>
                            <TextBlock x:Name="HoverGlyph" Style="{StaticResource CtrlGlyph}" FontSize="27">
                                <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                        <TextBlock x:Name="HoverTitle" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock x:Name="HoverSub" Foreground="#8E8E93" FontSize="12.5" HorizontalAlignment="Center" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" MaxWidth="330"/>
                    </StackPanel>
                </Grid>

                <!-- ============ DRAG & DROP: sending to the phone ============ -->
                <Grid x:Name="SendPanel" Opacity="0" IsHitTestVisible="False" Height="92" VerticalAlignment="Top" Margin="18,0,22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="56" Height="56" VerticalAlignment="Center">
                        <Rectangle x:Name="SendThumb" RadiusX="14" RadiusY="14" Fill="#2C2C2E"/>
                        <TextBlock x:Name="SendGlyph" Style="{StaticResource CtrlGlyph}" FontSize="22"/>
                        <Rectangle RadiusX="14" RadiusY="14" Stroke="#26FFFFFF" StrokeThickness="1"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Grid>
                            <TextBlock x:Name="SendTitle" Foreground="White" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,54,0"/>
                            <TextBlock x:Name="SendPct" Foreground="#64D2FF" FontSize="13.5" FontWeight="Bold" HorizontalAlignment="Right" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        </Grid>
                        <TextBlock x:Name="SendName" Foreground="#8E8E93" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,9"/>
                        <Grid x:Name="SendTrack" Height="6" ClipToBounds="True">
                            <Border CornerRadius="3" Background="#3A3A3C"/>
                            <Border x:Name="SendFill" CornerRadius="3" HorizontalAlignment="Left" Width="0" Background="{StaticResource DropGradient}">
                                <Border x:Name="SendShine" CornerRadius="3">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <LinearGradientBrush.RelativeTransform><TranslateTransform x:Name="ShineMove" X="-1"/></LinearGradientBrush.RelativeTransform>
                                            <GradientStop Color="#00FFFFFF" Offset="0.3"/>
                                            <GradientStop Color="#66FFFFFF" Offset="0.5"/>
                                            <GradientStop Color="#00FFFFFF" Offset="0.7"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- invisible, nearly transparent target that only exists while something is being dragged,
             so the drop zone is a bit bigger than the notch itself -->
        <Border x:Name="DropCatcher" Background="#01000000" Width="560" Height="236" VerticalAlignment="Top" HorizontalAlignment="Center"
                Visibility="Collapsed" AllowDrop="True"/>
    </Grid>
</Window>
