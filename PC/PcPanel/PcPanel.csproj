<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>PCPanel</AssemblyName>
    <RootNamespace>PcPanel</RootNamespace>
    <Product>PC Panel</Product>
    <AssemblyTitle>PC Panel</AssemblyTitle>
    <Company>PC Panel</Company>
    <Version>2.3.0</Version>
    <ApplicationIcon>Assets\PcPanel.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416;CS8632;CS0649;CS0169;CS0414;WFAC010</NoWarn>

    <!-- Low memory footprint -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\PcPanel.ico" />
    <Resource Include="Assets\Brand\*.png" />
    <EmbeddedResource Include="..\..\i18n\*.json" LogicalName="i18n.%(Filename).json" />
    <EmbeddedResource Include="Assets\Sounds\*.wav" LogicalName="snd.%(Filename).wav" />
  </ItemGroup>

</Project>
